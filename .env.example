# ── MaisonNova Engine v1 — Variables d'environnement ─────────────────
# Copier ce fichier en ".env" puis compléter (ou utiliser les secrets
# Streamlit Cloud en production — voir README → Déploiement).

# 🔐 Mot de passe de l'interface ADMIN (obligatoire de le changer !)
ADMIN_PASSWORD=changez-moi

# 🤖 Clé API Google Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modèle(s) IA, séparés par des virgules (repli automatique si le premier échoue)
# gemini-flash-latest suit automatiquement les modèles Google actuels (2.0-flash n'existe plus)
GEMINI_MODEL=gemini-flash-latest

# 🗄️ Stockage local (fichiers générés automatiquement)
AGENCY_FILE=agencies.json
LEADS_FILE=leads.csv
ALERTS_FILE=alerts.log

# 🌐 URL publique de l'application (pour générer les liens de qualification)
APP_BASE_URL=https://votre-app.streamlit.app

# ── Optionnel : Google Sheets (en plus du CSV) ────────────────────────
# 1) Télécharger un "service account" JSON depuis Google Cloud Console
# 2) Partager le spreadsheet avec l'email du service account
# GOOGLE_SHEETS_JSON=service-account.json
# GOOGLE_SHEETS_KEY=ID_DU_SPREADSHEET
# (Alternative : configurer directement depuis l'admin → onglet Google Sheets)
# SHEETS_CONFIG_FILE=sheets_config.json

# ── Optionnel : envoi SMTP réel (sinon l'alerte mail est simulée) ─────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre.email@gmail.com
# SMTP_PASSWORD=votre-mot-de-passe-application
